// OpenClaw final recommended config (safe version)
// Copy to: ~/.openclaw/openclaw.json
// Keep real secrets in environment variables.
{
  env: {
    OPENCLAW_GATEWAY_TOKEN: "${OPENCLAW_GATEWAY_TOKEN}",
    TELEGRAM_BOT_TOKEN: "${TELEGRAM_BOT_TOKEN}",
    OPENROUTER_API_KEY: "${OPENROUTER_API_KEY}",
    ANTHROPIC_API_KEY: "${ANTHROPIC_API_KEY}",
  },

  logging: {
    level: "info",
    consoleLevel: "info",
  },

  gateway: {
    mode: "local",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
  },

  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      userTimezone: "Europe/Lisbon",
      model: {
        primary: "openrouter/google/gemini-2.5-flash-lite",
        fallbacks: ["anthropic/claude-sonnet-4-5"],
      },
      models: {
        "openrouter/google/gemini-2.5-flash-lite": { alias: "flash" },
        "anthropic/claude-sonnet-4-5": { alias: "sonnet" },
      },
      thinkingDefault: "off",
      verboseDefault: "off",
      timeoutSeconds: 300,
      maxConcurrent: 2,
    },
    list: [
      {
        id: "main",
        default: true,
        identity: {
          name: "CLaiRinha",
          emoji: "lobster",
        },
      },
    ],
  },

  channels: {
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_BOT_TOKEN}",
      dmPolicy: "pairing",
      groups: {
        "*": {
          requireMention: true,
        },
      },
    },
  },
}
